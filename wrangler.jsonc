{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-calling-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALLS",
        "class_name": "CallController"
      },
      {
        "name": "OWNER",
        "class_name": "OwnerController"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CallController",
        "OwnerController"
      ]
    }
  ],
  "vars": {
    "LIVE_ENABLED": "false",
    "CONTROLLED_TEST_NUMBER": "",
    "CONTROLLED_TEST_UNTIL": "0",
    "PUBLIC_BASE_URL": "https://your-calling-assistant.example.com",
    "ACCOUNT_HEADROOM_VERIFIED": "false",
    "ROLLOUT_VERIFIED": "false",
    "OPENAI_LIVE_MODEL": "gpt-live-1",
    "REASONING_MODEL": "gpt-5.6-terra",
    "SUMMARY_MODEL": "gpt-5.6-luna",
    "DEEP_MODEL": "gpt-6-astra",
    "MONTHLY_LIMIT_CENTS": "5000",
    "DAILY_MINUTES": "90",
    "MAX_CALL_MINUTES": "45",
    "TRANSCRIPT_RETENTION_DAYS": "30",
    "AUDIO_CODEC": "L16",
    "MONTHLY_FIXED_ALLOWANCE_CENTS": "200"
  }
}
